{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeServe scripted inventory workload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "seed",
    "trace_mode",
    "model_revision",
    "initial_inventory",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "trace_mode": {
      "const": "scripted"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "initial_inventory": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "op_id",
              "token_ids",
              "tool_name",
              "args"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "op_id": {
                "type": "string",
                "minLength": 1
              },
              "token_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "tool_name": {
                "const": "read_inventory"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "op_id",
              "token_ids",
              "tool_name",
              "args"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "op_id": {
                "type": "string",
                "minLength": 1
              },
              "token_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "tool_name": {
                "const": "decrement_inventory"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "quantity"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
